  "fallbackPatterns": [
    {
      "pattern": "^nuthead",
      "part": "NutHead",
      "priority": 1
    },
    {
      "pattern": "^nut",
      "part": "Nut",
      "priority": 2
    },
    {
      "pattern": "^socket",
      "part": "Socket",
      "priority": 3
    },
    {
      "pattern": "^press[-_ ]?lock",
      "part": "Press Lock",
      "priority": 4
    },
    {
      "pattern": "^crimp",
      "part": "Crimp",
      "priority": 5
    },
    {
      "pattern": "^keep[-_ ]?plate",
      "part": "KeepPlate",
      "priority": 6
    },
    {
      "pattern": "^bolt",
      "part": "Bolt",
      "priority": 7
    }
  ]
